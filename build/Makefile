# Compile the Ghidra reconstruction under ../src with the MSYS2 toolchain.
#
#   make -C build            # objects for all four programs, then the summary
#   make -C build syntax     # -fsyntax-only pass only (obj/<prog>/<mod>.syn, no stubbing)
#   make -C build objs       # i386 COFF objects (obj/<prog>/<mod>.o); STUBS=0 = no fallback
#   make -C build summary    # files / functions that compile, per program
#   make -C build errors     # most common diagnostics behind stubbed/failed modules
#   make -C build link       # stretch goal: link each program (see BUILD_NOTES.md)
#   make -C build clean
#   variables: OPT=-O2, EXTRA_CFLAGS=..., CC=..., SRC=..., OBJ=...
#
# The tree is regenerated by `python -I tools/build_src.py`; nothing in ../src is
# edited by hand. Everything compiler-specific lives in compat.h (force-included).
#
# Every file is compiled with -m32 so that pointers, `int` and `long` are 32 bits,
# matching Ghidra's view of the x86 binaries (all the `(int)ptr + 0x10` arithmetic
# in the decompilation depends on this).

SRC      := ../src
OBJ      := obj
PROGS    := GRIMFANDANGO.EXE LUA.DLL IMUSE.DLL CHORE.DLL

# UCRT64 gcc can emit i386 objects with -m32 (it cannot link them: no 32-bit
# libraries). The i686 toolchain in /mingw32 is used for `make link` if present.
#
# On Linux (or any host whose gcc does not target Windows) the MinGW-w64 i686 cross compiler
# is used for both steps (Debian/Ubuntu: apt install gcc-mingw-w64-i686 libz-mingw-w64-dev;
# Fedora: mingw32-gcc mingw32-zlib-static). Override with CROSS=<prefix>- (e.g. CROSS=i686-w64-mingw32-).
HOST_GCC_TARGET := $(shell gcc -dumpmachine 2>/dev/null)
ifeq ($(findstring mingw,$(HOST_GCC_TARGET)),)
CROSS    ?= i686-w64-mingw32-
endif
ifeq ($(origin CC),default)
CC       := $(CROSS)gcc
endif
ifneq ($(CROSS),)
CC32LINK ?= $(shell command -v $(CROSS)gcc 2>/dev/null || echo $(CROSS)gcc)
endif
PYTHON   ?= $(if $(shell command -v python 2>/dev/null),python,python3) -I
CC32LINK ?= /mingw32/bin/gcc
ARCH     := -m32 -march=i686

# Ghidra C is not valid ISO C; keep the compiler as permissive as it goes:
#   -fpermissive          GCC >= 14 downgrades int-conversion / implicit-decl /
#                         incompatible-pointer errors back to warnings in C
#   -w                    and then silence all warnings
#   -fno-builtin          the CRT functions in crt.c redefine strlen, memcpy, ...
#   -fno-strict-aliasing  everything is reinterpreted through casts
#   -fwrapv               Ghidra arithmetic assumes two's-complement wraparound
#   -ffreestanding        no hosted headers: the decompiled CRT (crt.c) defines
#                         _errno, malloc, ... itself
OPT      ?= -O0          # make OPT=-O2 ; extra flags: make EXTRA_CFLAGS=...
GHIDRA_CFLAGS := $(OPT) $(ARCH) -std=gnu11 -fpermissive -w -Wno-error=incompatible-pointer-types -Wno-error=int-conversion -Wno-error=implicit-function-declaration -fno-builtin -fno-strict-aliasing \
            -fwrapv -fsingle-precision-constant -fno-common -ffreestanding -include compat.h -I.

# Per-module optimisation (see BUILD_NOTES.md, "Performance"): opt.mk sets OPT_<PROG>/<module> variables, e.g.
#   OPT_GRIMFANDANGO.EXE/insane := -O2
# The value is appended after $(OPT) (the last -O wins), so everything not listed keeps $(OPT) (-O0).
# `make OPT_ALL=-O1` is a quick experiment that forces a level for every listed or unlisted module.
OPTMK ?= opt.mk
-include $(OPTMK)
OPT_ALL ?=
MODOPT = $(OPT_$*) $(OPT_ALL)

# make sees GRIMFANDANGO.EXE etc. as plain directory names; nothing special needed.
SRCS_ALL := $(foreach p,$(PROGS),$(wildcard $(SRC)/$(p)/*.c))
SYNS     := $(patsubst $(SRC)/%.c,$(OBJ)/%.syn,$(SRCS_ALL))
OBJS     := $(patsubst $(SRC)/%.c,$(OBJ)/%.o,$(SRCS_ALL))

.PHONY: all syntax objs summary errors clean link
# -k: one broken module must not stop the others
MAKEFLAGS += -k

all: objs
	@$(MAKE) --no-print-directory summary

syntax: $(SYNS)
objs: $(OBJS)

.SECONDEXPANSION:

# Syntax pass: obj/<prog>/<mod>.syn on success, <mod>.syn.log with the
# diagnostics on failure (the next `make syntax` retries only failing files).
$(OBJ)/%.syn: $(SRC)/%.c compat.h $$(wildcard $(SRC)/$$(dir $$*)*.h)
	@mkdir -p $(dir $@)
	@if $(CC) $(GHIDRA_CFLAGS) $(MODOPT) $(EXTRA_CFLAGS) -fsyntax-only $< 2> $(OBJ)/$*.syn.log; then \
	   touch $@; rm -f $(OBJ)/$*.syn.log; else echo "FAIL syntax $*"; false; fi

# Objects. A module with errors is retried once with the failing functions'
# bodies replaced by a trap (stubify.py -> obj/<prog>/<mod>.stub.c). The
# compiler's diagnostics stay in <mod>.log next to the object so that
# `make summary` can count the stubbed functions. STUBS=0 turns this off.
STUBS ?= 1

# The compiler flags of every object are kept in obj/<prog>/<mod>.flags (rewritten only when they change),
# so editing opt.mk, OPT_ALL= or EXTRA_CFLAGS= rebuilds exactly the modules whose flags changed.
.PRECIOUS: $(OBJ)/%.flags
.PHONY: FORCE
FORCE:
$(OBJ)/%.flags: FORCE
	@mkdir -p $(dir $@)
	@echo '$(GHIDRA_CFLAGS) $(MODOPT) $(EXTRA_CFLAGS)' | cmp -s - $@ || echo '$(GHIDRA_CFLAGS) $(MODOPT) $(EXTRA_CFLAGS)' > $@

$(OBJ)/%.o: $(SRC)/%.c compat.h stubify.py $(OBJ)/%.flags $$(wildcard $(SRC)/$$(dir $$*)*.h)
	@mkdir -p $(dir $@)
	@rm -f $(OBJ)/$*.stub.c $(OBJ)/$*.stub.log
	@if $(CC) $(GHIDRA_CFLAGS) $(MODOPT) $(EXTRA_CFLAGS) -c $< -o $@ 2> $(OBJ)/$*.log; then \
	   rm -f $(OBJ)/$*.log; \
	 elif [ "$(STUBS)" = 1 ] && $(PYTHON) stubify.py $< $(OBJ)/$*.log $(OBJ)/$*.stub.c \
	      && $(CC) $(GHIDRA_CFLAGS) $(MODOPT) $(EXTRA_CFLAGS) -I$(dir $<) -c $(OBJ)/$*.stub.c -o $@ 2> $(OBJ)/$*.stub.log; then \
	   rm -f $(OBJ)/$*.stub.log; \
	 else echo "FAIL $*"; rm -f $@; false; fi

summary:
	@$(PYTHON) summary.py "$(SRC)" "$(OBJ)" $(PROGS)

# histogram of the compiler errors behind every stubbed/failed module
errors:
	@cat $(OBJ)/*/*.log 2>/dev/null | grep -E 'error:' | sed -E 's/^[^:]*:[0-9]+:[0-9]+: //; s/[0-9a-f]{8}/XXXXXXXX/g' \
	  | sed -E "s/'[^']*'/'_'/g" | sort | uniq -c | sort -rn | head -40

link: objs
	@$(PYTHON) link.py "$(CC32LINK)" "$(SRC)" "$(OBJ)" $(PROGS)

clean:
	rm -rf $(OBJ)
